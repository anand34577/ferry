<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (320x180dp): brand colour with the launcher glyph centred. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape><solid android:color="@color/icon_bg" /></shape>
    </item>
    <item android:width="180dp" android:height="180dp" android:gravity="center" android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
